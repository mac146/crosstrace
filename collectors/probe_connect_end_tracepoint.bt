/*
 * Connection completion via the sock:inet_sock_set_state tracepoint: the FALLBACK when fentry is not available.
 * Spliced into the main program by collectors/ebpf.py (the connect-end splice point). Known weakness: under heavy load about 0.1% of these events
 * were skipped (see probe_connect_end_fentry.bt), so a connection occasionally has no connect_end.
 */
/* SYN_SENT (2) -> ESTABLISHED (1): the three-way handshake finished */
tracepoint:sock:inet_sock_set_state
/args->protocol == 6 && args->oldstate == 2 && args->newstate == 1 && @c_t[(uint64)args->skaddr] != 0/
{
  $sk = (uint64)args->skaddr;
  printf("{\"ev\":\"tcp_connect_end\",\"t\":%llu,\"pid\":%d,\"tid\":%d,\"saddr\":\"%s\",\"sport\":%d,\"daddr\":\"%s\",\"dport\":%d,\"lat_ns\":%llu,\"sk\":%llu}\n",
         nsecs, @o_pid[$sk], @o_tid[$sk], ntop(args->saddr), args->sport, ntop(args->daddr), args->dport,
         nsecs - @c_t[$sk], $sk);
  delete(@c_t[$sk]);
}
